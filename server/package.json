{
  "name": "password-manager-zk-server",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge password manager API server",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "db:check": "node src/migrate.js --check",
    "db:migrate": "node src/migrate.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "cookie": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "jsonwebtoken": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "nodemon": "latest",
    "supertest": "latest"
  }
}
