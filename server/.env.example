PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
TOTP_ENC_KEY=replace-with-a-base64-key-of-exactly-32-bytes-openssl-rand-base64-32
# Desactivado por defecto. Solo activalo si el servidor esta detras de un proxy
# inverso, para que el rate limiting use la IP real del cliente ("1", "loopback", "true").
# TRUST_PROXY=1
